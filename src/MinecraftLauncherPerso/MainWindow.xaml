<Window x:Class="MinecraftLauncherPerso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Algaron Launcher"
        Width="860" Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource InkBrush}">
    <Grid>
        <!-- Halo de fond (signature Algaron) : deux dégradés radiaux, violet et cyan. -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="380" Canvas.Top="-260" Width="620" Height="480">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#337B5CFF" Offset="0" />
                        <GradientStop Color="#007B5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="-160" Canvas.Top="-60" Width="480" Height="360">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2200E5C7" Offset="0" />
                        <GradientStop Color="#0000E5C7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barre de titre personnalisée (fenêtre sans chrome Windows) -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid Width="18" Height="18" Margin="0,0,10,0">
                        <Rectangle Width="13" Height="13" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.3"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock Text="A L G A R O N   L A U N C H E R" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                               Foreground="{StaticResource InkDimBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource GhostButtonStyle}" Click="MinimizeButton_Click" />
                    <Button Content="✕" Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Contenu principal -->
            <Grid Grid.Row="1" Margin="32,0,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Bloc marque : losange cyan filaire + cœur plein (placeholder en attendant le logo officiel) -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,20">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center">
                        <Rectangle Width="52" Height="52" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                            <Rectangle.Effect>
                                <DropShadowEffect Color="{StaticResource ColorCyan}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
                            </Rectangle.Effect>
                        </Rectangle>
                        <Rectangle Width="22" Height="22" Fill="{StaticResource CyanBrush}" Opacity="0.85"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock Text="ALGARON" HorizontalAlignment="Center" Margin="0,10,0,0"
                               FontFamily="{StaticResource DisplayFontFamily}" FontWeight="Bold" FontSize="30"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="L A U N C H E R" HorizontalAlignment="Center" Margin="0,2,0,0"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                               Foreground="{StaticResource CyanBrush}" />
                </StackPanel>

                <!-- Panneau journal (liseré cyan -> violet -> magenta en haut, réservé au bloc principal) -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource ColorCyan}" Offset="0" />
                                    <GradientStop Color="{StaticResource ColorViolet}" Offset="0.5" />
                                    <GradientStop Color="{StaticResource ColorMagenta}" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBox x:Name="StatusLogTextBox" Grid.Row="1" Style="{StaticResource StatusLogStyle}"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!-- Barre de contrôle : progression, RAM, bouton Jouer -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="ProgressBar" Grid.Row="0" Grid.ColumnSpan="3" Height="4" Margin="0,0,0,14"
                                 Minimum="0" Maximum="100"
                                 Background="{StaticResource Surface2Brush}" BorderThickness="0"
                                 Foreground="{StaticResource CyanBrush}" />

                    <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom">
                        <TextBlock Text="RAM (MO)" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,4" />
                        <TextBox x:Name="MaxRamTextBox" Style="{StaticResource AlgaronTextBoxStyle}" Width="110" Text="6144" />
                    </StackPanel>

                    <Button x:Name="PlayButton" Grid.Row="1" Grid.Column="2" Content="JOUER"
                            Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"
                            Click="PlayButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
