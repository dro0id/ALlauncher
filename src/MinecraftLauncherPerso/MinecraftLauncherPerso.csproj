<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MinecraftLauncherPerso</RootNamespace>
    <AssemblyName>MinecraftLauncherPerso</AssemblyName>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gère la version vanilla, le classpath et le lancement du jeu (arguments JVM/jeu). -->
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <!-- Installation de Forge (mapping de version + téléchargement des libs Forge). -->
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <!-- Authentification Microsoft (device code flow) pour obtenir la session Minecraft. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.88.0" />
  </ItemGroup>

</Project>
